{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SurgeSpace",
  "version": "2.0.1",
  "identifier": "app.engspace.surgespace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "SurgeSpace", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://surgespace-licences.engspace.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Network surge (water hammer) analysis",
    "longDescription": "SurgeSpace simulates pressure surges in water networks and pipelines, sizes surge protection automatically and shows the waves moving through the network.",
    "copyright": "© 2026 Engineering Workspace",
    "publisher": "Engineering Workspace",
    "homepage": "https://engspace.app/surgespace",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["surge.json"], "name": "SurgeSpace project", "description": "SurgeSpace project", "role": "Editor", "mimeType": "application/json" }
    ],
    "macOS": { "minimumSystemVersion": "11.0", "hardenedRuntime": true },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
